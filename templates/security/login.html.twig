{% extends 'base.html.twig' %}

{% block title %}Connexion — Gestion Articles{% endblock %}

{% block stylesheets %}
<style>
body {
    background: #fff !important;
    min-height: 100vh;
}
.login-page { min-height: 100vh; display: flex; align-items: center; padding: 3rem 0; }
.login-logo { height: 72px; filter: drop-shadow(0 4px 10px rgba(0,0,0,.15)); }
.login-title { color: #1a1a2e; letter-spacing: .5px; }
.login-card {
    border: 1px solid #eee;
    border-radius: 1rem;
    box-shadow: 0 15px 35px rgba(0,0,0,.08);
}
.login-card .card-body { padding: 2.25rem; }
.login-card .form-control,
.login-card .input-group-text { border-color: #dee2e6; }
.login-card .form-control:focus { box-shadow: 0 0 0 .2rem rgba(13,110,253,.15); }
.login-card .btn-primary {
    background: linear-gradient(135deg, #1a1a2e 0%, #2b4a8f 100%);
    border: none;
    border-radius: .5rem;
    padding: .6rem 1rem;
    font-weight: 600;
}
.login-card .btn-primary:hover { filter: brightness(1.15); }
</style>
{% endblock %}

{% block body %}
<div class="login-page">
<div class="container">
<div class="row justify-content-center mb-4">

    {# ── Formulaire ── #}
    <div class="col-12 col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <img src="{{ asset('logo2026.png') }}" alt="Fournitures" class="login-logo">
            <h1 class="h3 mt-3 fw-bold login-title">Fournitures</h1>
        </div>

        <div class="card login-card">
            <div class="card-body">
                {% if error %}
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        {{ error.messageKey == 'Invalid credentials.' ? 'Nom ou mot de passe incorrect.' : error.messageKey|trans({}, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}" novalidate>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="mb-3">
                        <label for="lastName" class="form-label fw-semibold">Nom</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" id="lastName" name="lastName" class="form-control"
                                   value="{{ last_username }}" autocomplete="username" autofocus required placeholder="Votre nom">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Mot de passe</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" id="password" name="password" class="form-control"
                                   autocomplete="current-password" required placeholder="••••••••">
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Se connecter
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>
</div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.getElementById('togglePassword').addEventListener('click', function () {
    var input = document.getElementById('password');
    var icon  = document.getElementById('togglePasswordIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
});
</script>
{% endblock %}
