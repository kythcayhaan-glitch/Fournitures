{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Gestion Articles{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/login.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="login-page">
<div class="container">
<div class="row justify-content-center">
    <div class="col-12 col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <img src="{{ asset('logo2026.png') }}" alt="Fournitures" class="login-logo">
            <h1 class="h3 mt-3 fw-bold login-title">Nouveau mot de passe</h1>
        </div>

        <div class="card login-card">
            <div class="card-body">
                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.newPassword.first, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.newPassword.first) }}
                        {{ form_errors(form.newPassword.first) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.newPassword.second, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.newPassword.second) }}
                        {{ form_errors(form.newPassword.second) }}
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
</div>
</div>
{% endblock %}
