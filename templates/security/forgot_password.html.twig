{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — Gestion Articles{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/login.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="login-page">
<div class="container">
<div class="row justify-content-center">
    <div class="col-12 col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <img src="{{ asset('logo2026.png') }}" alt="Fournitures" class="login-logo">
            <h1 class="h3 mt-3 fw-bold login-title">Mot de passe oublié</h1>
        </div>

        <div class="card login-card">
            <div class="card-body">
                {% include 'security/_flashes.html.twig' %}

                <p class="text-muted small">Saisissez l'email de votre compte : un lien pour choisir un nouveau mot de passe vous sera envoyé.</p>

                <form method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                    <div class="mb-4">
                        <label for="email" class="form-label fw-semibold">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" id="email" name="email" class="form-control" autocomplete="email" autofocus required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-1"></i> Envoyer le lien
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}" class="small">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>
{% endblock %}
