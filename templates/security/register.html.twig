{% extends 'base.html.twig' %}

{% block title %}Créer un compte — Gestion Articles{% endblock %}

{% block stylesheets %}
<link href="{{ asset('css/login.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="login-page">
<div class="container">
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="text-center mb-4">
            <img src="{{ asset('logo2026.png') }}" alt="Fournitures" class="login-logo">
            <h1 class="h3 mt-3 fw-bold login-title">Créer un compte</h1>
        </div>

        <div class="card login-card">
            <div class="card-body">
                <p class="text-muted small">Votre compte devra être validé par un administrateur avant la première connexion. Vous vous connecterez avec votre <strong>nom</strong>.</p>

                {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.firstName, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.firstName) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.lastName, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.lastName) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.service, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.service) }}
                        {{ form_errors(form.service) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.first) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.plainPassword.second) }}
                        {{ form_errors(form.plainPassword.second) }}
                        {{ form_errors(form.plainPassword) }}
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-person-plus me-1"></i> Créer mon compte
                        </button>
                    </div>
                </div>
                {{ form_end(form) }}

                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}" class="small">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
</div>
{% endblock %}
